[Unit]
Description=Govee H5151 manager
After=bluetooth.target govee-bt.service
Requires=bluetooth.target
Wants=govee-bt.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/govee-history/gateway.py --db /var/lib/govee-history/history.db
Restart=on-failure
User=govee
SupplementaryGroups=bluetooth
# Load Connection Parameters needs this. The bluetooth group can open the
# socket, and the kernel still returns permission denied without the cap.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
