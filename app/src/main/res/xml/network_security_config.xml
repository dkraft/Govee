<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- IP literals follow the base config, not domain-config. HistoryClient opens only 10.0.0.69. -->
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.0.69</domain>
    </domain-config>
</network-security-config>
